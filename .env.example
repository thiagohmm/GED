# Copie para .env e ajuste os valores. NUNCA commite o .env preenchido.

# --- PostgreSQL (docker compose + backend) ---
POSTGRES_PASSWORD=change-me
GED_DB_HOST=localhost
GED_DB_PORT=5432
GED_DB_NAME=ged
GED_DB_USER=ged
GED_DB_PASSWORD=change-me

# --- JWT (backend + OnlyOffice Document Server) ---
# Obrigatorio: minimo 32 caracteres, mesmo segredo nos dois lados.
GED_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-chars
GED_JWT_EXPIRATION_MINUTES=720

# --- Seed do primeiro start ---
GED_SEED_ADMIN_USERNAME=admin
GED_SEED_ADMIN_PASSWORD=change-me

# --- Elasticsearch ---
GED_ES_ENABLED=true
GED_ES_URL=http://localhost:9200

# --- Armazenamento de binarios ---
GED_STORAGE_DIR=storage
