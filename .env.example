# ==============================================================
# GED - configuracao de ambiente
# Copie para .env (docker compose usa este arquivo automaticamente)
# ==============================================================

# ----- Segredos (OBRIGATORIOS em producao) ---------------------
# Gere com: openssl rand -hex 32
# O backend usa GED_JWT_SECRET para os tokens de autenticacao e do editor.
GED_JWT_SECRET=troque-este-segredo-em-producao-com-no-minimo-32-caracteres

# Senha do Postgres (usada pelo docker-compose.yml)
POSTGRES_PASSWORD=ged

# ----- Banco de dados (opcional; padrao local) -----------------
# GED_DB_HOST=localhost
# GED_DB_PORT=5432
# GED_DB_NAME=ged
# GED_DB_USER=ged
# GED_DB_MAINTENANCE_NAME=postgres

# ----- Seed de producao (primeira subida) ----------------------
# Se nao existir SUPER_ADMIN no banco, ambas as variaveis sao
# OBRIGATORIAS para a subida com o profile prod criar o admin global.
# GED_SUPER_ADMIN_USERNAME=root
# GED_SUPER_ADMIN_PASSWORD=

# ----- Backup / integridade ------------------------------------
# Diretorio de backups (nao versionado; veja .gitignore)
# GED_BACKUP_DIR=backups
# Diretorio contendo pg_dump/psql (vazio = PATH do sistema)
# GED_PGBIN_DIR=

# ----- Armazenamento e busca (opcional) ------------------------
# GED_STORAGE_DIR=storage
# GED_ES_ENABLED=true
# GED_ES_URL=http://localhost:9200
# GED_EDITOR_URL=http://localhost:8090
# GED_EDITOR_PUBLIC_BACKEND_URL=http://host.docker.internal:8080
